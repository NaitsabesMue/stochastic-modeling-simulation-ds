#!/bin/sh
# Reject private paths even if somebody used git add -f.
git diff --cached --name-only -z | python3 -c '
import sys

private_prefixes = (
    "students/", "instructor/", "data/raw/", "data/private/",
    "submissions/", "feedback/", "copies examen/", "week01/exit_quiz",
)
private_files = {
    "notes_renfort_info_2_2025_2026.csv", "auto_grade.py", "grading_prompt.md",
}
paths = (p.decode("utf-8", "surrogateescape") for p in sys.stdin.buffer.read().split(b"\0") if p)
bad = [p for p in paths if p.startswith(private_prefixes) or p in private_files]
for path in bad:
    print(f"Refusing private staged path: {path}", file=sys.stderr)
sys.exit(bool(bad))
'
